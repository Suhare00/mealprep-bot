# Copy this file to .env and replace the placeholder values for local development.
APP_ENV=development
LOG_LEVEL=info
TELEGRAM_BOT_TOKEN=replace-with-development-token

POSTGRES_DB=mealprep
POSTGRES_USER=mealprep
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgres://mealprep:replace-with-local-password@localhost:5432/mealprep?sslmode=disable
TEST_DATABASE_URL=postgres://mealprep:replace-with-local-password@localhost:5432/mealprep_test?sslmode=disable
